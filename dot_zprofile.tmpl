# =============================================================================
# Zsh login profile — runs for login shells (GUI apps, SSH, new terminals).
# =============================================================================

# --- Homebrew (macOS) --------------------------------------------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# --- SSH agent (reuse existing, auto-add allowed keys) -----------------------
if [[ -z "${SSH_AUTH_SOCK:-}" ]] && command -v ssh-agent >/dev/null 2>&1; then
  eval "$(ssh-agent -s)" >/dev/null 2>&1
fi
if [[ -n "${SSH_AUTH_SOCK:-}" ]] && command -v ssh-add >/dev/null 2>&1; then
  _cm_add_key() {
    local key="$HOME/.ssh/id_ed25519_$1"
    [[ -f "$key" ]] || return 0
    if [[ "$(uname -s)" = Darwin ]]; then
      ssh-add --apple-use-keychain "$key" 2>/dev/null
    else
      ssh-add "$key" 2>/dev/null
    fi
  }
{{- $ctx := .context | default "personal" -}}
{{- if eq $ctx "personal" }}
  _cm_add_key neo
  _cm_add_key atreides
{{- else if hasPrefix $ctx "work-" }}
  _cm_add_key {{ trimPrefix $ctx "work-" }}
{{- end }}
{{- range $p := .enabledWorkProfiles | default list }}
  _cm_add_key {{ (index $.profiles $p).ssh_key }}
{{- end }}
  for key in ~/.ssh/id_ed25519 ~/.ssh/id_rsa(N); do
    [[ -f "$key" ]] && \
      { [[ "$(uname -s)" = Darwin ]] && ssh-add --apple-use-keychain "$key" 2>/dev/null || ssh-add "$key" 2>/dev/null; }
  done
  unset -f _cm_add_key
fi
