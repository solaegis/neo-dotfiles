# =============================================================================
# Zsh login profile — runs for login shells (GUI apps, SSH, new terminals).
# Keep minimal: PATH and env that non-interactive / child processes need.
# =============================================================================

# --- Homebrew (macOS) --------------------------------------------------------
# Ensures brew and formulae are on PATH for GUI apps and subshells.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# --- SSH agent (reuse existing, auto-add keys) -------------------------------
if [[ -z "${SSH_AUTH_SOCK:-}" ]] && command -v ssh-agent >/dev/null 2>&1; then
  eval "$(ssh-agent -s)" >/dev/null 2>&1
fi
if [[ -n "${SSH_AUTH_SOCK:-}" ]] && command -v ssh-add >/dev/null 2>&1; then
  for key in ~/.ssh/id_*(N); do
    [[ -f "$key" && "$key" != *.pub ]] && \
      { [[ "$(uname -s)" = Darwin ]] && ssh-add --apple-use-keychain "$key" 2>/dev/null || ssh-add "$key" 2>/dev/null; }
  done
fi

# --- OrbStack (Docker, orb host) ---------------------------------------------
[[ -f "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"

# --- GCP SDK (gcloud) --------------------------------------------------------
[[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]] && source "$HOME/google-cloud-sdk/path.zsh.inc"

# --- Node / JDK (Homebrew; add if dirs exist) --------------------------------
[[ -d /opt/homebrew/opt/node@20/bin ]] && path=( /opt/homebrew/opt/node@20/bin $path )
[[ -d /usr/local/opt/node@20/bin ]] && path=( /usr/local/opt/node@20/bin $path )
[[ -d /opt/homebrew/opt/openjdk@11/bin ]] && path=( /opt/homebrew/opt/openjdk@11/bin $path )
[[ -d /usr/local/opt/openjdk@11/bin ]] && path=( /usr/local/opt/openjdk@11/bin $path )

# --- AWS profile (host guard for work machine) -------------------------------
if [[ "$(hostname)" =~ "^(atreides|Atreides)$" ]]; then
  export AWS_DEFAULT_PROFILE="${AWS_DEFAULT_PROFILE:-default}"
fi

# --- Brew requirements (install once, then optional) -------------------------
# Run these for the full zsh setup (macOS with Homebrew):
#
#   brew install zsh git fzf
#
# Oh My Zsh and Powerlevel10k are installed via their installers, not brew:
#
#   # Oh My Zsh
#   sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
#
#   # Powerlevel10k (theme)
#   git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
#
#   # Recommended OMZ custom plugins (syntax highlighting, autosuggestions)
#   git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
#   git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
#
