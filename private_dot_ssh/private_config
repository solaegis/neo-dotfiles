# GitHub — one host alias per identity (clone as git@github.com-ALIAS:org/repo.git)
Host github.com-acxiom
  HostName github.com
  IdentityFile ~/.ssh/id_ed25519_acxiom

Host github.com-solaegis
  HostName github.com
  IdentityFile ~/.ssh/id_ed25519_solaegis

Host github.com-dadandlad
  HostName github.com
  IdentityFile ~/.ssh/id_ed25519_dadandlad

Host github.com-nuvent
  HostName github.com
  IdentityFile ~/.ssh/id_ed25519_nuvent

# Remote development (Cursor / VS Code Remote-SSH)
# Cursor is blocked from LAN by macOS Local Network privacy; route via localhost relay.
# Relay: ~/Library/LaunchAgents/com.lvavasour.atreides-ssh-relay.plist
Host atreides.local
  HostName 127.0.0.1
  Port 2222
  User lvavasour
  IdentityFile ~/.ssh/id_ed25519_atreides
  CheckHostIP no
  StrictHostKeyChecking accept-new

# Over Tailscale
Host atreides
  HostName 100.88.223.50
  User lvavasour
  IdentityFile ~/.ssh/id_ed25519_atreides

# Default GitHub and other hosts
Host github.com
  IdentityFile ~/.ssh/id_ed25519_solaegis
Host *
  IdentityFile ~/.ssh/id_ed25519_solaegis
