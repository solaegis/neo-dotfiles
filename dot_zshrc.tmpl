# =============================================================================
# Main zsh config — sources modular files. Edit via chezmoi source.
# =============================================================================
[[ -f "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]] \
  && source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"

ZDOTDIR="${ZDOTDIR:-$HOME}"
ZSH_CONFIG_DIR="${ZSH_CONFIG_DIR:-$ZDOTDIR/.zsh}"

{{ template "zsh/environment-shared.zsh" . }}
{{ template "zsh/oh-my-zsh-shared.zsh" . }}
{{ template "zsh/aliases-shared.zsh" . }}

{{- $ctx := .context | default "personal" -}}
{{- if eq $ctx "personal" }}
{{ template "zsh/personal.zsh" . }}
{{- end }}
{{- $workTooling := or (hasPrefix $ctx "work-") (gt ((.enabledWorkProfiles | default list) | len) 0) -}}
{{- if $workTooling }}
{{ template "zsh/work-common.zsh" . }}
{{- end }}

[[ -f "$ZSH_CONFIG_DIR/completion.zsh" ]]     && source "$ZSH_CONFIG_DIR/completion.zsh"
[[ -f "$ZSH_CONFIG_DIR/keybindings.zsh" ]]    && source "$ZSH_CONFIG_DIR/keybindings.zsh"
[[ -f "$ZSH_CONFIG_DIR/functions.zsh" ]]      && source "$ZSH_CONFIG_DIR/functions.zsh"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
