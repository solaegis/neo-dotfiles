# Homebrew formulae and casks. Generated from .chezmoidata.toml.
# Install: brew bundle install --file="$HOME/Brewfile"

{{- define "brewSection" -}}
{{- range index . "formulae" | default list }}
brew "{{ . }}"
{{- end }}
{{- range index . "casks" | default list }}
cask "{{ . }}"
{{- end }}
{{- range index . "vscode" | default list }}
vscode "{{ . }}"
{{- end }}
{{- range index . "cargo" | default list }}
cargo "{{ . }}"
{{- end }}
{{- range index . "services" | default list }}
brew services start {{ .name }}
{{- end }}
{{- end }}

{{- range index .brew.shared "taps" | default list }}
tap "{{ . }}"
{{- end }}

# --- Shared baseline ---
{{- template "brewSection" .brew.shared }}

{{- if eq .chezmoi.os "linux" }}
# --- Linux ---
{{- template "brewSection" .brew.linux }}
{{- end }}

{{- $ctx := .context | default "personal" -}}
{{- if eq $ctx "personal" }}
# --- Personal context ---
{{- template "brewSection" .brew.personal }}
{{- else if hasPrefix $ctx "work-" }}
# --- Work context ---
{{- template "brewSection" .brew.work }}
{{- $slug := trimPrefix $ctx "work-" }}
{{- with index .brew.profiles $slug }}
# --- Work profile: {{ $slug }} ---
{{- template "brewSection" . }}
{{- end }}
{{- end }}

{{- range $p := .enabledWorkProfiles | default list }}
{{- with index $.brew.profiles $p }}
# --- Enabled profile: {{ $p }} ---
{{- template "brewSection" . }}
{{- end }}
{{- end }}

{{- with index .brew.hosts .chezmoi.hostname }}
# --- Host: {{ $.chezmoi.hostname }} ---
{{- template "brewSection" . }}
{{- end }}
