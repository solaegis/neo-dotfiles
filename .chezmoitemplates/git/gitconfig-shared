# Shared git config: aliases and defaults (all contexts).

[init]
	defaultBranch = main

[alias]
	ac = !git add -A && git commit -m
	cam = commit -am
	br = branch -vv
	co = checkout
	cob = checkout -b
	cm = !git pull && git branch --merged | grep -Ev '(^\\*|main|master|develop|prod)' | xargs -n 1 git branch -d
	ff = merge --no-ff
	rb = rebase
	rbi = rebase -i
	lg = log --graph --abbrev-commit --decorate --oneline --all
	lp = log --pretty=oneline
	ll = log --oneline --graph --decorate --all -20
	search = log -S
	st = status
	po = push origin
